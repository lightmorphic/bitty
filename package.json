{
  "name": "bitty",
  "productName": "Bitty",
  "version": "0.2.2",
  "description": "VPN-only BitTorrent client. Self-contained AppImage. No traffic ever leaves except through the VPN tunnel.",
  "main": "src/main/main.js",
  "private": true,
  "author": "Charlie",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "webtorrent": "^2.5.5",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cx.charlie.bitty",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "!renderer/assets/fonts/*.ttf.license"
    ],
    "asarUnpack": [
      "node_modules/webtorrent/**",
      "node_modules/utp-native/**",
      "node_modules/fs-native-extensions/**",
      "node_modules/node-datachannel/**",
      "node_modules/bufferutil/**",
      "node_modules/utf-8-validate/**"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "lightmorphic",
      "repo": "bitty"
    }
  }
}
